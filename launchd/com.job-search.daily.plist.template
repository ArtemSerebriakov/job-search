<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.job-search.daily</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Open the runner app (it holds the Desktop-folder permission), wait for it, keep it in the background. -->
    <string>/usr/bin/open</string>
    <string>-W</string>
    <string>-g</string>
    <string>-a</string>
    <string>__RUNNER_APP__</string>
  </array>
  <!-- Every 30 minutes; a start missed while the Mac sleeps runs on the next wake. scripts/daily.sh
       decides whether to run: only 08:00-22:00, not with the lid closed on battery (dark wake), at most
       3 real attempts a day, and not again once today's digest was sent. -->
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/logs/launchd.err.log</string>
</dict>
</plist>
